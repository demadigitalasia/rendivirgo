# --- Database -------------------------------------------------------------
DATABASE_URL="postgresql://drefan@localhost:5432/rendi_virgo_dev?schema=public"

# --- Server ---------------------------------------------------------------
PORT=4000
NODE_ENV=development
APP_ORIGIN="http://localhost:3000"

# --- Auth -----------------------------------------------------------------
# Keep stable during migration of legacy encrypted settings and encrypted auth emails; also signs shared auth rate-limit keys.
SESSION_SECRET="change-me-to-a-random-secret-of-at-least-32-characters"
SESSION_TTL_HOURS=12
ADMIN_EMAIL="admin@rendivirgo.com"
# Required; the API refuses to bootstrap without an explicit password.
ADMIN_PASSWORD="set-a-long-random-password"
ADMIN_NAME="Rendi Virgo"

# --- AI product copy via OpenRouter (optional) ----------------------------
# Dashboard-managed keys take precedence; this server-only value remains a fallback.
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openai/gpt-4.1-mini"
# Models that administrators may select, as a comma-separated allowlist.
AI_ALLOWED_MODELS="openai/gpt-4.1-mini"
# App-side safety limits. Set an OpenRouter provider spend limit as an additional backstop.
AI_MONTHLY_BUDGET_USD=25
AI_REQUEST_RESERVATION_USD=0.10
AI_DAILY_REQUEST_LIMIT=50
AI_DAILY_ADMIN_REQUEST_LIMIT=30
AI_MAX_CONCURRENT_REQUESTS=2
# Required to save dashboard-managed AI keys. Use a separate stable secret of 32+ random characters.
# Existing keys encrypted with the old SESSION_SECRET are migrated on first provider use after this is configured.
AI_ENCRYPTION_KEY=""
# During key rotation, set the previous key here until the stored key has been re-encrypted.
AI_ENCRYPTION_KEY_PREVIOUS=""

# --- Uploads --------------------------------------------------------------
UPLOAD_DIR="uploads"
PUBLIC_API_URL="http://localhost:4000"

# --- Payments (PayPal REST API) -------------------------------------------
PAYPAL_ENV="sandbox"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
# Unpaid orders release reserved stock after this many minutes (min 10)
ORDER_RESERVATION_MINUTES=60

# --- Etsy Open API v3 (optional) ------------------------------------------
# Register a Seller App for your own shop in the Etsy Developer Portal.
# The callback must exactly match the registered HTTPS redirect URI.
ETSY_API_KEY=""
ETSY_SHARED_SECRET=""
ETSY_REDIRECT_URI="https://your-store.example/api/admin/integrations/etsy/oauth/callback"
# Etsy listing defaults. Use IDs and enum values from the Etsy shop/API.
# Product currency must match the Etsy shop currency. Etsy currently marks readiness profiles as a migration feature.
ETSY_DEFAULT_TAXONOMY_ID=""
ETSY_DEFAULT_SHIPPING_PROFILE_ID=""
ETSY_DEFAULT_RETURN_POLICY_ID=""
ETSY_DEFAULT_READINESS_STATE_ID=""
ETSY_DEFAULT_WHO_MADE=""
ETSY_DEFAULT_WHEN_MADE=""
ETSY_DEFAULT_IS_SUPPLY=""

# --- Email (Resend) -------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="RENDI VIRGO <orders@rendivirgo.com>"
EMAIL_REPLY_TO=""

# --- Proxy ----------------------------------------------------------------
# Number of trusted proxy hops in front of the API (Coolify/Next proxy = 1)
TRUST_PROXY=1
# How often the API sweeps for expired unpaid orders (ms, min 10000)
PAYMENT_SWEEP_INTERVAL_MS=300000
# Retention for audit logs (days); sessions kept 7 days, notifications 90 days
AUDIT_RETENTION_DAYS=365
