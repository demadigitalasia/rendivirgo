# --- Database -------------------------------------------------------------
DATABASE_URL="postgresql://drefan@localhost:5432/rendi_virgo_dev?schema=public"

# --- Server ---------------------------------------------------------------
PORT=4000
NODE_ENV=development
APP_ORIGIN="http://localhost:3000"

# --- Auth -----------------------------------------------------------------
SESSION_SECRET="change-me-in-production"
SESSION_TTL_HOURS=12
ADMIN_EMAIL="admin@rendivirgo.com"
# Required; the API refuses to bootstrap without an explicit password.
ADMIN_PASSWORD="set-a-long-random-password"
ADMIN_NAME="Rendi Virgo"

# --- Uploads --------------------------------------------------------------
UPLOAD_DIR="uploads"
PUBLIC_API_URL="http://localhost:4000"

# --- Payments (PayPal REST API) -------------------------------------------
PAYPAL_ENV="sandbox"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
# Unpaid orders release reserved stock after this many minutes (min 10)
ORDER_RESERVATION_MINUTES=60

# --- Email (Resend) -------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="RENDI VIRGO <orders@rendivirgo.com>"
EMAIL_REPLY_TO=""

# --- Proxy ----------------------------------------------------------------
# Number of trusted proxy hops in front of the API (Coolify/Next proxy = 1)
TRUST_PROXY=1
# How often the API sweeps for expired unpaid orders (ms, min 10000)
PAYMENT_SWEEP_INTERVAL_MS=300000
