generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- enums

enum ProductStatus {
  Draft
  Published
  Reserved
  Sold
  Archived
}

enum StockModel {
  Unique
  Quantity
}

enum ProductUnit {
  piece
  pair
  gram
  carat
  strand
  bag
}

enum StoneCondition {
  Natural
  Treated
  Dyed
}

enum ProductTone {
  moss
  jade
  amber
  ocean
  earth
}

enum ShippingClass {
  Standard
  Fragile
  Oversized
  Custom
}

enum CalculationMethod {
  CarrierAPI
  AdminOverride
}

enum OrderStatus {
  New
  Processing
  Packed
  Shipped
  Completed
  Cancelled
  Returned
}

enum PaymentStatus {
  Pending
  Paid
  Failed
  Refunded
  PartiallyRefunded
}

enum PaymentMethod {
  PayPal
  BankTransfer
  Manual
}

enum ContentStatus {
  Draft
  Published
  Scheduled
  Archived
}

enum DiscountType {
  Percentage
  Fixed
  FreeShipping
}

enum MessageStatus {
  New
  Read
  Replied
  Archived
}

enum NotificationType {
  Order
  Stock
  Review
  Message
  System
}

enum BannerPlacement {
  HomeHero
  HomeOwner
  Promo
}

// ---------------------------------------------------------------- admin & auth

model Admin {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  avatarUrl    String?
  totpSecret   String?
  totpEnabled  Boolean   @default(false)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions AdminSession[]
  auditLogs AuditLog[]
  orderEvents OrderEvent[]
}

model AdminSession {
  id        String    @id @default(cuid())
  adminId   String
  tokenHash String    @unique
  ip        String?
  userAgent String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([expiresAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  adminId    String?
  action     String
  entityType String
  entityId   String?
  summary    String
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  admin Admin? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
}

// ---------------------------------------------------------------- catalog

model Category {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  description  String?
  imageUrl     String?
  tone         ProductTone @default(moss)
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  metaTitle    String?
  metaDescription String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  products  Product[]
  discounts Discount[]

  @@index([sortOrder])
}

model Product {
  id             String        @id @default(cuid())
  slug           String        @unique
  sku            String        @unique
  name           String
  categoryId     String
  stoneType      String
  origin         String
  mohsHardness   Float?
  condition      StoneCondition @default(Natural)
  price          Decimal       @db.Decimal(12, 2)
  compareAtPrice Decimal?      @db.Decimal(12, 2)
  currency       String        @default("USD")
  unit           ProductUnit   @default(piece)
  stockModel     StockModel    @default(Unique)
  stockQuantity  Int?
  weightGram     Int
  weightCarat    Float?
  lengthMm       Int?
  widthMm        Int?
  heightMm       Int?
  status         ProductStatus @default(Draft)
  tone           ProductTone   @default(moss)
  shippingClass  ShippingClass @default(Standard)
  shippingProfileId String?
  description    String        @default("")
  featured       Boolean       @default(false)
  fragile        Boolean       @default(false)
  metaTitle      String?
  metaDescription String?
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  category       Category        @relation(fields: [categoryId], references: [id])
  images         ProductImage[]
  variants       ProductVariant[]
  orderItems     OrderItem[]
  priceHistory   ProductPriceHistory[]
  testimonials   Testimonial[]

  @@index([categoryId])
  @@index([status])
  @@index([featured])
  @@index([createdAt])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  focalX    Float?
  focalY    Float?
  sortOrder Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductVariant {
  id                String   @id @default(cuid())
  productId         String
  sku               String   @unique
  name              String
  price             Decimal  @db.Decimal(12, 2)
  stockQuantity     Int      @default(1)
  weightGram        Int
  lengthMm          Int?
  widthMm           Int?
  heightMm          Int?
  shippingClass     ShippingClass @default(Standard)
  shippingProfileId String?
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  product  Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([productId])
}

model ProductPriceHistory {
  id        String   @id @default(cuid())
  productId String
  field     String
  oldValue  String?
  newValue  String
  adminId   String?
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ShippingProfile {
  id                 String            @id @default(cuid())
  name               String
  packageWeightGram  Int
  packageLengthMm    Int?
  packageWidthMm     Int?
  packageHeightMm    Int?
  shippingClass      ShippingClass     @default(Standard)
  calculationMethod  CalculationMethod @default(CarrierAPI)
  packageModel       String            @default("SinglePackageTotalWeight")
  handlingFee        Decimal           @default(0) @db.Decimal(12, 2)
  insuranceFee       Decimal           @default(0) @db.Decimal(12, 2)
  fragileFee         Decimal           @default(0) @db.Decimal(12, 2)
  oversizedFee       Decimal           @default(0) @db.Decimal(12, 2)
  isDefault          Boolean           @default(false)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
}

model ShippingRate {
  id            String   @id @default(cuid())
  name          String
  carrier       String?
  region        String   @default("Worldwide")
  minWeightGram Int      @default(0)
  maxWeightGram Int?
  price         Decimal  @db.Decimal(12, 2)
  handlingFee   Decimal  @default(0) @db.Decimal(12, 2)
  insuranceFee  Decimal  @default(0) @db.Decimal(12, 2)
  fragileFee    Decimal  @default(0) @db.Decimal(12, 2)
  oversizedFee  Decimal  @default(0) @db.Decimal(12, 2)
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isActive, sortOrder])
}

// ---------------------------------------------------------------- customers & orders

model Customer {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  phone         String?
  country       String?
  countryCode   String?
  city          String?
  state         String?
  postalCode    String?
  addressLine1  String?
  addressLine2  String?
  tags          String[] @default([])
  notes         String?
  acceptsMarketing Boolean @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orders Order[]

  @@index([createdAt])
}

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique
  customerId      String?
  email           String
  customerName    String
  phone           String?
  status          OrderStatus   @default(New)
  paymentStatus   PaymentStatus @default(Pending)
  paymentMethod   PaymentMethod @default(PayPal)
  paymentRef      String?
  currency        String        @default("USD")
  subtotal        Decimal       @db.Decimal(12, 2)
  shippingCost    Decimal       @db.Decimal(12, 2)
  discountTotal   Decimal       @default(0) @db.Decimal(12, 2)
  taxTotal        Decimal       @default(0) @db.Decimal(12, 2)
  total           Decimal       @db.Decimal(12, 2)
  refundedAmount  Decimal       @default(0) @db.Decimal(12, 2)
  discountId      String?
  discountCode    String?
  shippingName    String?
  carrier         String?
  trackingNumber  String?
  trackingUrl     String?
  totalWeightGram Int           @default(0)
  shippingLine1   String?
  shippingLine2   String?
  shippingCity    String?
  shippingState   String?
  shippingPostalCode String?
  shippingCountry String?
  shippingCountryCode String?
  customerNote    String?
  internalNote    String?
  placedAt        DateTime      @default(now())
  paidAt          DateTime?
  packedAt        DateTime?
  shippedAt       DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  customer Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  discount Discount?   @relation(fields: [discountId], references: [id], onDelete: SetNull)
  items    OrderItem[]
  events   OrderEvent[]

  @@index([status])
  @@index([paymentStatus])
  @@index([placedAt])
  @@index([email])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  productId   String?
  variantId   String?
  name        String
  sku         String
  unitPrice   Decimal @db.Decimal(12, 2)
  quantity    Int     @default(1)
  weightGram  Int     @default(0)
  lineTotal   Decimal @db.Decimal(12, 2)
  imageUrl    String?

  order   Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant?  @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  adminId   String?
  type      String
  message   String
  createdAt DateTime @default(now())

  order Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  admin Admin? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

// ---------------------------------------------------------------- marketing

model Discount {
  id            String       @id @default(cuid())
  code          String       @unique
  description   String?
  type          DiscountType @default(Percentage)
  value         Decimal      @db.Decimal(12, 2)
  minSubtotal   Decimal      @default(0) @db.Decimal(12, 2)
  maxUses       Int?
  usedCount     Int          @default(0)
  perCustomerLimit Int?
  startsAt      DateTime?
  endsAt        DateTime?
  isActive      Boolean      @default(true)
  categoryId    String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  orders   Order[]

  @@index([isActive])
}

// ---------------------------------------------------------------- content

model BlogPost {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  excerpt        String        @default("")
  body           String        @default("")
  coverImage     String?
  tags           String[]      @default([])
  status         ContentStatus @default(Draft)
  author         String        @default("RENDI VIRGO")
  readMinutes    Int           @default(5)
  views          Int           @default(0)
  metaTitle      String?
  metaDescription String?
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status, publishedAt])
}

model Page {
  id              String        @id @default(cuid())
  slug            String        @unique
  title           String
  body            String        @default("")
  status          ContentStatus @default(Published)
  showInFooter    Boolean       @default(true)
  sortOrder       Int           @default(0)
  metaTitle       String?
  metaDescription String?
  updatedAt       DateTime      @updatedAt
  createdAt       DateTime      @default(now())
}

model Testimonial {
  id          String   @id @default(cuid())
  customerName String
  location    String?
  quote       String
  rating      Int      @default(5)
  productId   String?
  isPublished Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
}

model Banner {
  id        String          @id @default(cuid())
  title     String
  subtitle  String?
  imageUrl  String?
  ctaLabel  String?
  ctaHref   String?
  placement BannerPlacement @default(HomeHero)
  focalX    Float?
  focalY    Float?
  isActive  Boolean         @default(true)
  sortOrder Int             @default(0)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([placement, isActive])
}

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------- inbox

model Message {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  body      String
  status    MessageStatus @default(New)
  adminReply String?
  repliedAt DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
}

model Notification {
  id         String           @id @default(cuid())
  type       NotificationType @default(System)
  title      String
  body       String?
  href       String?
  entityType String?
  entityId   String?
  isRead     Boolean          @default(false)
  createdAt  DateTime         @default(now())

  @@index([isRead, createdAt])
}

// ---------------------------------------------------------------- media & utilities

model MediaAsset {
  id           String   @id @default(cuid())
  url          String
  filename     String
  originalName String
  mimeType     String
  size         Int
  width        Int?
  height       Int?
  folder       String   @default("products")
  createdAt    DateTime @default(now())

  @@index([folder])
}

model Sequence {
  key   String @id
  value Int    @default(0)
}
