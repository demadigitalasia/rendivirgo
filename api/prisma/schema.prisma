generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- enums

enum ProductStatus {
  Draft
  Published
  Reserved
  Sold
  Archived
}

enum StockModel {
  Unique
  Quantity
}

enum ProductUnit {
  piece
  pair
  gram
  carat
  strand
  bag
}

enum ProductTone {
  moss
  jade
  amber
  ocean
  earth
}

enum TranslationStatus {
  Missing
  Draft
  Review
  Ready
}

enum ShippingClass {
  Standard
  Fragile
  Oversized
  Custom
}

enum CalculationMethod {
  CarrierAPI
  AdminOverride
}

enum OrderStatus {
  New
  Processing
  Packed
  Shipped
  Completed
  Cancelled
  Returned
}

enum PaymentStatus {
  Pending
  Paid
  Failed
  Refunded
  PartiallyRefunded
}

enum PaymentMethod {
  PayPal
  BankTransfer
  Manual
  Cash
  QRIS
}

enum OrderSource {
  Online
  POS
  Wholesale
}

enum FulfillmentMethod {
  Shipping
  WorkshopPickup
}

enum ContentStatus {
  Draft
  Published
  Scheduled
  Archived
}

enum BlogAuthorType {
  Person
  Organization
}

enum DiscountType {
  Percentage
  Fixed
  FreeShipping
}

enum MessageStatus {
  New
  Read
  Replied
  Archived
}

enum NotificationType {
  Order
  Stock
  Review
  Message
  System
}

enum OrderOutboxKind {
  OrderReceivedCustomer
  OrderReceivedAdmin
  PaymentReceivedCustomer
}

enum OrderOutboxStatus {
  Pending
  Processing
  Sent
}

enum AuthEmailOutboxKind {
  CustomerVerification
  CustomerPasswordReset
  AdminPasswordReset
}

enum AuthEmailOutboxStatus {
  Pending
  Processing
  Sent
  Cancelled
  Failed
}

enum OrderReturnRequestStatus {
  Pending
  Approved
  Rejected
}

enum ReviewStatus {
  Pending
  Published
  Rejected
}

enum EtsySyncStatus {
  Pending
  Processing
  Synced
  Failed
}

enum BannerPlacement {
  HomeHero
  HomeOwner
  Promo
}

// ---------------------------------------------------------------- admin & auth

model Admin {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  avatarUrl    String?
  totpSecret   String?
  totpEnabled  Boolean   @default(false)
  resetTokenHash String?
  resetTokenExpiresAt DateTime?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions AdminSession[]
  auditLogs AuditLog[]
  orderEvents OrderEvent[]
  returnReviews OrderReturnRequest[]
}

model AdminSession {
  id        String    @id @default(cuid())
  adminId   String
  tokenHash String    @unique
  ip        String?
  userAgent String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([expiresAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  adminId    String?
  action     String
  entityType String
  entityId   String?
  summary    String
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  admin Admin? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([adminId])
}

model AuthEmailOutbox {
  id              String                 @id @default(cuid())
  kind            AuthEmailOutboxKind
  status          AuthEmailOutboxStatus  @default(Pending)
  targetId        String
  tokenHash       String                 @unique
  dedupeKey       String                 @unique
  encryptedPayload String                @db.Text
  expiresAt       DateTime
  attempts        Int                    @default(0)
  availableAt     DateTime               @default(now())
  lockedAt        DateTime?
  lastError       String?
  sentAt          DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([status, availableAt, createdAt])
  @@index([status, lockedAt])
  @@index([status, expiresAt])
}

model AuthRateLimitBucket {
  key       String   @id
  count     Int      @default(0)
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

// ---------------------------------------------------------------- catalog

model Category {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  description  String?
  imageUrl     String?
  tone         ProductTone @default(moss)
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  metaTitle    String?
  metaDescription String?
  nameId          String?
  descriptionId   String?
  metaTitleId     String?
  metaDescriptionId String?
  idTranslationStatus TranslationStatus @default(Missing)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  products  Product[]
  discounts Discount[]

  @@index([sortOrder])
}

model ConditionOption {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String   @unique
  note      String?
  noteId    String?
  idTranslationStatus TranslationStatus @default(Missing)
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

model Product {
  id             String        @id @default(cuid())
  slug           String        @unique
  sku            String        @unique
  name           String
  categoryId     String
  stoneType      String
  origin         String
  mohsHardness   Float?
  condition      String         @default("Natural")
  price          Decimal       @db.Decimal(12, 2)
  compareAtPrice Decimal?      @db.Decimal(12, 2)
  currency       String        @default("USD")
  unit           ProductUnit   @default(piece)
  stockModel     StockModel    @default(Unique)
  stockQuantity  Int?
  sellOnWeb      Boolean       @default(true)
  sellInWorkshop Boolean       @default(true)
  sellInWholesale Boolean      @default(false)
  sellInEtsy     Boolean       @default(false)
  wholesalePrice Decimal?      @db.Decimal(12, 2)
  wholesalePiecesPerUnit Int?
  workshopStockQuantity Int    @default(0)
  // Legacy storage from the initial POS pricing draft; cart prices are saved on OrderItem.
  workshopPriceIdr Decimal?    @db.Decimal(12, 2)
  weightGram     Int
  weightCarat    Float?
  lengthMm       Int?
  widthMm        Int?
  heightMm       Int?
  status         ProductStatus @default(Draft)
  tone           ProductTone   @default(moss)
  shippingClass  ShippingClass @default(Standard)
  shippingProfileId String?
  description    String        @default("")
  videoUrl       String?
  featured       Boolean       @default(false)
  fragile        Boolean       @default(false)
  metaTitle      String?
  metaDescription String?
  nameId          String?
  descriptionId   String?
  metaTitleId     String?
  metaDescriptionId String?
  idTranslationStatus TranslationStatus @default(Missing)
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  category       Category        @relation(fields: [categoryId], references: [id])
  images         ProductImage[]
  variants       ProductVariant[]
  orderItems     OrderItem[]
  priceHistory   ProductPriceHistory[]
  testimonials   Testimonial[]
  reviews        ProductReview[]
  etsyListingMapping EtsyListingMapping?
  etsySyncJob    EtsySyncJob?

  @@index([categoryId])
  @@index([status])
  @@index([featured])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([categoryId, status])
}

model EtsyShopConnection {
  id                    String   @id @default("primary")
  shopId                String
  userId                String
  shopName              String
  currencyCode          String
  accessTokenEncrypted  String   @db.Text
  refreshTokenEncrypted String   @db.Text
  tokenExpiresAt        DateTime
  refreshLockedAt       DateTime?
  connectedAt           DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model EtsyOAuthState {
  id                    String   @id @default(cuid())
  stateHash             String   @unique
  codeVerifierEncrypted String   @db.Text
  adminSessionId        String
  expiresAt              DateTime
  createdAt              DateTime @default(now())

  @@index([expiresAt])
  @@index([adminSessionId, expiresAt])
}

model EtsyListingMapping {
  id              String   @id @default(cuid())
  productId       String   @unique
  shopId          String?
  etsyListingId   String   @unique
  listingUrl      String?
  remoteState     String   @default("draft")
  imageFingerprint String  @default("")
  imageIds        String[] @default([])
  creationAttemptAt DateTime?
  lastSyncedAt    DateTime?
  lastError       String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([remoteState])
  @@index([shopId])
}

model EtsySyncJob {
  productId   String         @id
  status      EtsySyncStatus @default(Pending)
  revision    Int            @default(1)
  attempts    Int            @default(0)
  availableAt DateTime       @default(now())
  lockedAt    DateTime?
  lastError   String?        @db.Text
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([status, availableAt, createdAt])
  @@index([status, lockedAt])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  focalX    Float?
  focalY    Float?
  sortOrder Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductVariant {
  id                String   @id @default(cuid())
  productId         String
  sku               String   @unique
  name              String
  price             Decimal  @db.Decimal(12, 2)
  wholesalePrice    Decimal? @db.Decimal(12, 2)
  wholesalePiecesPerUnit Int?
  stockQuantity     Int      @default(1)
  workshopStockQuantity Int  @default(0)
  // Legacy storage from the initial POS pricing draft; cart prices are saved on OrderItem.
  workshopPriceIdr  Decimal? @db.Decimal(12, 2)
  weightGram        Int
  lengthMm          Int?
  widthMm           Int?
  heightMm          Int?
  shippingClass     ShippingClass @default(Standard)
  shippingProfileId String?
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  product  Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([productId])
}

model ProductPriceHistory {
  id        String   @id @default(cuid())
  productId String
  field     String
  oldValue  String?
  newValue  String
  adminId   String?
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ShippingProfile {
  id                 String            @id @default(cuid())
  name               String
  packageWeightGram  Int
  packageLengthMm    Int?
  packageWidthMm     Int?
  packageHeightMm    Int?
  shippingClass      ShippingClass     @default(Standard)
  calculationMethod  CalculationMethod @default(CarrierAPI)
  packageModel       String            @default("SinglePackageTotalWeight")
  handlingFee        Decimal           @default(0) @db.Decimal(12, 2)
  insuranceFee       Decimal           @default(0) @db.Decimal(12, 2)
  fragileFee         Decimal           @default(0) @db.Decimal(12, 2)
  oversizedFee       Decimal           @default(0) @db.Decimal(12, 2)
  isDefault          Boolean           @default(false)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
}

model ShippingRate {
  id            String   @id @default(cuid())
  name          String
  carrier       String?
  region        String   @default("Worldwide")
  minWeightGram Int      @default(0)
  maxWeightGram Int?
  deliveryMinDays Int    @default(3)
  deliveryMaxDays Int    @default(7)
  price         Decimal  @db.Decimal(12, 2)
  handlingFee   Decimal  @default(0) @db.Decimal(12, 2)
  insuranceFee  Decimal  @default(0) @db.Decimal(12, 2)
  fragileFee    Decimal  @default(0) @db.Decimal(12, 2)
  oversizedFee  Decimal  @default(0) @db.Decimal(12, 2)
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isActive, sortOrder])
}

// ---------------------------------------------------------------- customers & orders

model Customer {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  phone         String?
  country       String?
  countryCode   String?
  city          String?
  state         String?
  postalCode    String?
  addressLine1  String?
  addressLine2  String?
  tags          String[] @default([])
  notes         String?
  acceptsMarketing Boolean @default(false)
  passwordHash String?
  emailVerifiedAt DateTime?
  verificationTokenHash String? @unique
  verificationTokenExpiresAt DateTime?
  resetTokenHash String? @unique
  resetTokenExpiresAt DateTime?
  wholesaleAccess Boolean @default(false)
  wholesaleApprovedAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orders Order[]
  sessions CustomerSession[]

  @@index([createdAt])
}

model CustomerSession {
  id        String   @id @default(cuid())
  customerId String
  tokenHash String   @unique
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, revokedAt, expiresAt])
}

model PosReservation {
  id          String   @id @default(cuid())
  requestId   String   @unique
  fingerprint String
  adminId     String
  createdAt   DateTime @default(now())
  expiresAt   DateTime
  committedAt DateTime?
  releasedAt  DateTime?
  items       PosReservationItem[]

  @@index([expiresAt, committedAt, releasedAt])
}

model PosReservationItem {
  id            String    @id @default(cuid())
  reservationId String
  productId     String
  variantId     String?
  stockModel    StockModel
  quantity      Int

  reservation PosReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId])
  @@index([productId, variantId])
}

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique
  checkoutKey     String?       @unique
  checkoutFingerprint String?
  customerId      String?
  email           String?
  customerName    String
  phone           String?
  status          OrderStatus   @default(New)
  paymentStatus   PaymentStatus @default(Pending)
  paymentMethod   PaymentMethod @default(PayPal)
  source          OrderSource   @default(Online)
  fulfillmentMethod FulfillmentMethod @default(Shipping)
  paymentRef      String?
  paypalOrderId   String?       @unique
  paymentProofPath String?
  paymentProofMime String?
  paymentProofUploadedAt DateTime?
  currency        String        @default("USD")
  exchangeRate    Decimal?      @db.Decimal(12, 4)
  subtotal        Decimal       @db.Decimal(12, 2)
  shippingCost    Decimal       @db.Decimal(12, 2)
  discountTotal   Decimal       @default(0) @db.Decimal(12, 2)
  manualDiscountType DiscountType?
  manualDiscountValue Decimal?  @db.Decimal(12, 2)
  discountReason  String?
  taxTotal        Decimal       @default(0) @db.Decimal(12, 2)
  total           Decimal       @db.Decimal(12, 2)
  refundedAmount  Decimal       @default(0) @db.Decimal(12, 2)
  discountId      String?
  discountCode    String?
  shippingName    String?
  carrier         String?
  trackingNumber  String?
  trackingUrl     String?
  totalWeightGram Int           @default(0)
  shippingLine1   String?
  shippingLine2   String?
  shippingCity    String?
  shippingState   String?
  shippingPostalCode String?
  shippingCountry String?
  shippingCountryCode String?
  customerNote    String?
  internalNote    String?
  placedAt        DateTime      @default(now())
  paidAt          DateTime?
  packedAt        DateTime?
  shippedAt       DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  customer Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  discount Discount?   @relation(fields: [discountId], references: [id], onDelete: SetNull)
  items    OrderItem[]
  events   OrderEvent[]
  reviews  ProductReview[]
  outboxEvents OrderOutbox[]
  returnRequests OrderReturnRequest[]

  @@index([status])
  @@index([paymentStatus])
  @@index([paymentMethod, paymentStatus, paymentProofUploadedAt])
  @@index([placedAt])
  @@index([source, placedAt])
  @@index([email])
  @@index([customerId])
  @@index([customerId, placedAt])
  @@index([status, placedAt])
  @@index([discountId])
}

model OrderOutbox {
  id          String           @id @default(cuid())
  orderId     String
  kind        OrderOutboxKind
  status      OrderOutboxStatus @default(Pending)
  dedupeKey   String           @unique
  attempts    Int              @default(0)
  availableAt DateTime         @default(now())
  lockedAt    DateTime?
  lastError   String?
  sentAt      DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status, availableAt, createdAt])
  @@index([status, lockedAt])
}

model OrderReturnRequest {
  id             String                   @id @default(cuid())
  orderId        String
  status         OrderReturnRequestStatus @default(Pending)
  reason         String
  details        String
  evidencePath   String?
  evidenceMime   String?
  adminResponse  String?
  reviewedById   String?
  submittedAt    DateTime                 @default(now())
  reviewedAt     DateTime?

  order      Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reviewedBy Admin? @relation(fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, submittedAt])
  @@index([orderId, submittedAt])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  productId   String?
  variantId   String?
  name        String
  sku         String
  unitPrice   Decimal @db.Decimal(12, 2)
  quantity    Int     @default(1)
  workshopAllocatedQuantity Int @default(0)
  weightGram  Int     @default(0)
  lineTotal   Decimal @db.Decimal(12, 2)
  imageUrl    String?

  order   Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant?  @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  adminId   String?
  type      String
  message   String
  createdAt DateTime @default(now())

  order Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  admin Admin? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

// ---------------------------------------------------------------- marketing

model Discount {
  id            String       @id @default(cuid())
  code          String       @unique
  description   String?
  type          DiscountType @default(Percentage)
  value         Decimal      @db.Decimal(12, 2)
  minSubtotal   Decimal      @default(0) @db.Decimal(12, 2)
  maxUses       Int?
  usedCount     Int          @default(0)
  perCustomerLimit Int?
  startsAt      DateTime?
  endsAt        DateTime?
  isActive      Boolean      @default(true)
  categoryId    String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  orders   Order[]

  @@index([isActive])
}

// ---------------------------------------------------------------- content

model BlogPost {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  excerpt        String        @default("")
  body           String        @default("")
  coverImage     String?
  coverAlt       String?
  coverAltId     String?
  tags           String[]      @default([])
  status         ContentStatus @default(Draft)
  author         String        @default("RENDI VIRGO")
  authorType     BlogAuthorType @default(Organization)
  authorUrl      String?
  readMinutes    Int           @default(5)
  views          Int           @default(0)
  metaTitle      String?
  metaDescription String?
  titleId         String?
  excerptId       String?
  bodyId          String?
  tagsId          String[]      @default([])
  metaTitleId     String?
  metaDescriptionId String?
  idTranslationStatus TranslationStatus @default(Missing)
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status, publishedAt])
}

model Page {
  id              String        @id @default(cuid())
  slug            String        @unique
  title           String
  body            String        @default("")
  status          ContentStatus @default(Published)
  showInFooter    Boolean       @default(true)
  sortOrder       Int           @default(0)
  metaTitle       String?
  metaDescription String?
  titleId         String?
  bodyId          String?
  metaTitleId     String?
  metaDescriptionId String?
  idTranslationStatus TranslationStatus @default(Missing)
  updatedAt       DateTime      @updatedAt
  createdAt       DateTime      @default(now())
}

model Testimonial {
  id          String   @id @default(cuid())
  customerName String
  location    String?
  quote       String
  quoteId     String?
  idTranslationStatus TranslationStatus @default(Missing)
  rating      Int      @default(5)
  productId   String?
  isPublished Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
}

model ProductReview {
  id               String       @id @default(cuid())
  productId        String
  orderId          String?
  name             String
  email            String
  rating           Int
  title            String?
  body             String
  status           ReviewStatus @default(Pending)
  verifiedPurchase Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([productId, status, createdAt])
  @@index([status, createdAt])
  @@index([email])
}

model Banner {
  id        String          @id @default(cuid())
  title     String
  subtitle  String?
  imageUrl  String?
  ctaLabel  String?
  ctaHref   String?
  placement BannerPlacement @default(HomeHero)
  focalX    Float?
  focalY    Float?
  isActive  Boolean         @default(true)
  sortOrder Int             @default(0)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([placement, isActive])
}

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------- inbox

model Message {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  body      String
  status    MessageStatus @default(New)
  adminReply String?
  repliedAt DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([email])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  locale    String?
  source    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, createdAt])
}

model Notification {
  id         String           @id @default(cuid())
  type       NotificationType @default(System)
  title      String
  body       String?
  href       String?
  entityType String?
  entityId   String?
  isRead     Boolean          @default(false)
  createdAt  DateTime         @default(now())

  @@index([isRead, createdAt])
  @@index([entityType, entityId])
}

// ---------------------------------------------------------------- media & utilities

model MediaAsset {
  id           String   @id @default(cuid())
  url          String
  filename     String
  originalName String
  mimeType     String
  size         Int
  width        Int?
  height       Int?
  folder       String   @default("products")
  createdAt    DateTime @default(now())

  @@index([folder])
  @@index([createdAt])
}

model Sequence {
  key   String @id
  value Int    @default(0)
}
