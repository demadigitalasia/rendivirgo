{
  "name": "rendi-virgo-api",
  "version": "0.1.0",
  "private": true,
  "description": "RENDI VIRGO store API (NestJS + PostgreSQL + Prisma)",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "dev": "nest start --watch",
